display_data <- archive_studies |>
dplyr::select(
ID = id,
`Study Name` = name,
`Principal Investigator` = principal_investigator_name,
`Number of Animals` = number_of_individuals,
`Sensor Types` = sensor_type_ids,
`Study Type` = study_type,
`License Type` = license_type,
`Timestamp First` = timestamp_first_deployed_location,
`Timestamp Last` = timestamp_last_deployed_location
) |>
mutate(
# Clean up timestamp columns
`Timestamp First` = as.Date(as.POSIXct(`Timestamp First`, origin="1970-01-01")),
`Timestamp Last` = as.Date(as.POSIXct(`Timestamp Last`, origin="1970-01-01"))
)
selectInput("study_type",
"Filter by Study Type:",
choices = c("All" = "", unique(display_data$`Study Type`)),
selected = "")
selectInput("license_type",
"Filter by License Type:",
choices = c("All" = "", unique(display_data$`License Type`)),
selected = "")
numericInput("min_animals",
"Minimum Number of Animals:",
value = 0,
min = 0)
dateRangeInput("date_range",
"Date Range (First Deployment):",
start = min(display_data$`Timestamp First`, na.rm = TRUE),
end = max(display_data$`Timestamp First`, na.rm = TRUE))
# Reactive filtered data
filtered_data <- reactive({
data <- display_data
# Filter by study type
if (input$study_type != "") {
data <- data |> filter(`Study Type` == input$study_type)
}
# Filter by license type
if (input$license_type != "") {
data <- data |> filter(`License Type` == input$license_type)
}
# Filter by minimum animals
data <- data |>
filter(`Number of Animals` >= input$min_animals | is.na(`Number of Animals`))
# Filter by date range
data <- data |>
filter(`Timestamp First` >= input$date_range[1] &
`Timestamp First` <= input$date_range[2] |
is.na(`Timestamp First`))
return(data)
})
# Render the DataTable
DT::renderDataTable({
DT::datatable(
filtered_data(),
options = list(
pageLength = 15,
scrollX = TRUE,
dom = 'Bfrtip',
buttons = c('copy', 'csv', 'excel'),
columnDefs = list(
list(width = '200px', targets = c(1, 2)), # Study Name and PI columns
list(className = 'dt-center', targets = c(3, 4, 8)) # Center numeric columns
)
),
extensions = 'Buttons',
filter = 'top',
rownames = FALSE,
class = 'cell-border stripe hover'
) |>
DT::formatDate(columns = c("Timestamp First", "Timestamp Last"), method = "toDateString")
}, server = FALSE)
# Summary statistics
renderText({
data <- filtered_data()
paste0("Showing ", nrow(data), " of ", nrow(display_data), " studies")
})
